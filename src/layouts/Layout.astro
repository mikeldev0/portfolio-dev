---
import "@fontsource-variable/onest";
import Background from "../components/Background.astro";
import Header from "../components/Header.astro";
import ScrollLinkedAvatar from "../components/ScrollLinkedAvatar.astro";
import Snowfall from "../components/Snowfall.astro";
import { env } from "../lib/env";
import { isWithinHolidaySeason } from "../lib/holiday";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  markdownPath?: string | null;
  robots?: string;
}

const {
  description,
  title,
  canonicalPath = "/",
  markdownPath = "/index.md",
  robots = "index, follow",
} = Astro.props;
const { enableHolidayEffects } = env;
const showHolidayEffects = enableHolidayEffects && isWithinHolidaySeason();
const siteUrl = "https://www.mikeldev.com";
const canonicalUrl = canonicalPath ? new URL(canonicalPath, siteUrl).toString() : null;
const markdownUrl = markdownPath ? new URL(markdownPath, siteUrl).toString() : null;
const personId = `${siteUrl}/#person`;
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const postalAddress = {
  "@type": "PostalAddress",
  addressLocality: "Pamplona",
  addressRegion: "Navarra",
  addressCountry: "ES",
};
const socialProfiles = [
  "https://github.com/mikeldev0",
  "https://www.linkedin.com/in/mikel-echeverria",
  "https://x.com/mikelecheve",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Mikel Echeverria",
      alternateName: ["mikeldev", "mikeldev0"],
      jobTitle: "Backend & Full Stack Engineer",
      url: `${siteUrl}/`,
      image: `${siteUrl}/photo.webp`,
      email: "mikel@mikeldev.com",
      address: postalAddress,
      knowsAbout: [
        "Backend engineering",
        "Full stack development",
        "API architecture",
        "Django",
        "React",
        "Astro",
        "Spring Boot",
        "SQL",
        "Artificial intelligence",
        "Automation",
      ],
      sameAs: socialProfiles,
      description:
        "Backend & Full Stack Engineer en Pamplona, España. Especializado en arquitectura de APIs, sistemas escalables, automatización e inteligencia artificial aplicada.",
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "mikeldev",
      url: `${siteUrl}/`,
      founder: { "@id": personId },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "professional inquiries",
        email: "mikel@mikeldev.com",
        availableLanguage: ["Spanish", "English"],
      },
      address: postalAddress,
      sameAs: socialProfiles,
      description:
        "Personal engineering portfolio and professional contact presence for Mikel Echeverria.",
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "mikeldev",
      alternateName: "Mikel Echeverria Portfolio",
      url: `${siteUrl}/`,
      about: { "@id": personId },
      publisher: { "@id": organizationId },
      inLanguage: ["es", "en", "fr", "de", "it"],
    },
  ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="title" content={title} />
    <meta
      name="keywords"
      content="Mikel Echeverria, mikeldev, Backend Engineer, Full Stack Engineer, desarrollador backend Pamplona, desarrollador full stack Navarra, API architecture, Django, React, Astro, Spring Boot, SQL, AI automation"
    />
    <meta name="author" content="Mikel Echeverria" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="describedby" href="/llms.txt" />
    {
      canonicalPath === "/" && (
        <>
          <link rel="alternate" hreflang="es" href={`${siteUrl}/`} />
          <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
          <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
        </>
      )
    }
    <meta name="theme-color" content="#faf8f5" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var isDark =
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (isDark) {
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#191919");
        }
      })();
    </script>

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/photo.webp`} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mikeldev" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/photo.webp`} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Background />
    {showHolidayEffects && <Snowfall />}
    <Header />
    <ScrollLinkedAvatar />
    <slot />
    <script src="/i18n.js" defer is:inline></script>
  </body>
</html>

<style is:global>
  :root {
    --bg: oklch(1 0.003 60); /* Parchment White */
    --surface: oklch(0.97 0.01 60);
    --ink: oklch(0.18 0.01 240);
    --ink-muted: oklch(0.45 0.01 240);
    --primary: oklch(0.2 0 0); /* Pure Dark Slate */
    --primary-muted: oklch(0.2 0 0 / 0.05);
    --accent: oklch(0.65 0.08 60); /* Gold / Bronze accent for light mode */
    --border: oklch(0.9 0.015 60);

    color-scheme: light dark;
  }

  .dark {
    --bg: oklch(0.1 0 0); /* Pure Neutral Dark (main branch style) */
    --surface: oklch(0.14 0 0);
    --ink: oklch(0.92 0 0);
    --ink-muted: oklch(0.6 0 0);
    --primary: oklch(0.98 0 0); /* Pure White */
    --primary-muted: oklch(0.98 0 0 / 0.1);
    --accent: oklch(0.4 0 0); /* Neutral Grey Accent */
    --border: oklch(0.2 0 0);
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    background-color: var(--bg);
    color: var(--ink);
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    min-height: 100vh;
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    overflow-x: clip;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: inherit;
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 70ch;
    text-wrap: pretty;
  }

  #hero-avatar-fallback,
  #header-avatar-fallback {
    transition: opacity 180ms ease;
  }

  #header-avatar-fallback {
    opacity: 0;
    visibility: hidden;
  }

  .scroll-avatar-ready #hero-avatar-fallback,
  .scroll-avatar-ready #header-avatar-fallback {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    #hero-avatar-fallback,
    #header-avatar-fallback {
      transition: none;
    }

    #header-avatar-fallback {
      opacity: 1;
      visibility: visible;
    }
  }

  @keyframes blur {
    to {
      backdrop-filter: blur(20px);
      background-color: oklch(from var(--bg) l 0 h / 0.5);
    }
  }

  #main-header {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }
</style>
